<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0f172a;color:#e2e8f0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,"PingFang SC","Microsoft YaHei",sans-serif;line-height:1.6;min-height:100vh}
.container{position:relative;max-width:720px;margin:0 auto;padding:24px 16px}
h1{font-size:1.8rem;color:#f1f5f9;margin-bottom:8px;text-align:center}
.subtitle{color:#94a3b8;text-align:center;margin-bottom:32px}
.card{background:#1e293b;border-radius:12px;padding:32px;border:1px solid rgba(148,163,184,.1)}
.recorder-area{text-align:center}
.status-bar{display:flex;justify-content:center;align-items:center;gap:12px;margin-bottom:24px}
.status-dot{width:12px;height:12px;border-radius:50%;background:#64748b;transition:all .3s}
.status-dot.recording{background:#ef4444;animation:pulse 1s infinite}
.status-dot.paused{background:#f59e0b}
.status-dot.playing{background:#22d3ee}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}
.status-text{color:#94a3b8;font-size:.9rem}
.time-display{font-size:3.5rem;font-weight:700;font-variant-numeric:tabular-nums;color:#f1f5f9;margin-bottom:24px;font-family:monospace;letter-spacing:2px}
.waveform{height:80px;background:#0f172a;border-radius:8px;margin-bottom:24px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid rgba(148,163,184,.1)}
.waveform canvas{width:100%;height:100%;display:block}
.controls{display:flex;justify-content:center;gap:16px;margin-bottom:24px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 28px;border-radius:50px;border:none;font-size:1rem;font-weight:600;cursor:pointer;transition:all .2s;min-width:120px}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn-record{background:#ef4444;color:#fff}
.btn-record:hover:not(:disabled){background:#dc2626}
.btn-record.recording{background:#64748b}
.btn-record.recording:hover:not(:disabled){background:#475569}
.btn-pause{background:#f59e0b;color:#fff}
.btn-pause:hover:not(:disabled){background:#d97706}
.btn-stop{background:#64748b;color:#fff}
.btn-stop:hover:not(:disabled){background:#475569}
.btn-play{background:#22d3ee;color:#0f172a}
.btn-play:hover:not(:disabled){background:#06b6d4}
.btn-download{background:rgba(6,182,212,.15);color:#22d3ee;border:1px solid rgba(6,182,212,.2)}
.btn-download:hover:not(:disabled){background:rgba(6,182,212,.25)}
.btn-clear{background:#1e293b;color:#94a3b8;border:1px solid rgba(148,163,184,.2)}
.btn-clear:hover:not(:disabled){border-color:#ef4444;color:#ef4444}
.size-info{color:#64748b;font-size:.85rem;margin-top:12px}
.format-select{display:inline-flex;align-items:center;gap:8px;background:#0f172a;padding:8px 16px;border-radius:8px;margin-top:8px}
.format-select label{color:#94a3b8;font-size:.85rem}
.format-select select{background:#1e293b;color:#e2e8f0;border:1px solid rgba(148,163,184,.2);padding:4px 8px;border-radius:4px;font-size:.85rem;outline:none}
.perm-msg{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5;padding:12px 16px;border-radius:8px;margin-bottom:16px;display:none;font-size:.9rem}
.error-msg{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5;padding:12px 16px;border-radius:8px;margin-bottom:16px;display:none;font-size:.9rem}
.lang-nav{display:flex;justify-content:center;gap:8px;margin-bottom:24px}
.lang-nav a{padding:6px 16px;border-radius:6px;font-size:.85rem;color:#94a3b8;border:1px solid rgba(148,163,184,.15);transition:all .2s}
.lang-nav a.active{background:rgba(6,182,212,.15);color:#22d3ee;border-color:rgba(6,182,212,.3)}
.footer{border-top:1px solid rgba(148,163,184,.1);padding:24px 0;margin-top:48px;text-align:center;color:#64748b;font-size:.85rem}
.features{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-top:24px}
.feature-item{background:#0f172a;padding:16px;border-radius:8px;text-align:center}
.feature-item .icon{font-size:1.5rem;margin-bottom:4px}
.feature-item p{color:#94a3b8;font-size:.85rem}
@media(max-width:480px){.time-display{font-size:2.5rem}.btn{padding:12px 20px;min-width:100px}
@media(max-width:640px){h1{font-size:1.2rem;word-break:break-word}.header{flex-direction:column;gap:8px}}
}}
</style>
